# Kalau pakai docker-compose.yml yang disediakan, nilai ini sudah pas:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/makeithappen"
# Di Supabase/hosting dengan connection pooler: DATABASE_URL pakai URL pooled,
# DIRECT_URL pakai URL non-pooled (dipakai khusus saat migrasi). Untuk lokal
# (Docker/Postgres biasa tanpa pooler), isi sama seperti DATABASE_URL di atas.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/makeithappen"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-password"
SESSION_SECRET="change-this-to-a-long-random-string"
# Set to "true" once the app is served over HTTPS (recommended in production)
COOKIE_SECURE="false"
